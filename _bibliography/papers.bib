@misc{lai2025amrscan,
  doi = {10.48550/ARXIV.2507.08062},
  url = {https://arxiv.org/abs/2507.08062},
  author = {Lai, Kaitao},
  keywords = {Genomics (q-bio.GN), FOS: Biological sciences},
  title = {AMRScan 2: provenance-recorded detection of antimicrobial resistance determinants in bacterial assemblies, with archived susceptibility data from NCBI Pathogen Detection},
  publisher = {arXiv},
  year = {2025},
  copyright = {Creative Commons Attribution Non Commercial Share Alike 4.0 International},
  bibtex_show = {true},
  abstract = {Studies that relate bacterial genomes to antimicrobial susceptibility test (AST) results need determinant calls and phenotypes that can be traced to the exact genome, software, database and source export they came from. AMRScan 2 is a rewrite of the AMRScan toolkit for this purpose. Its Nextflow workflow runs NCBI AMRFinderPlus on genome assemblies in a pinned container, writes a provenance record for every sample with the command, the software version and the SHA-256 hashes of the input, of every database file and of the report, and converts each report into a table with a fixed schema that keeps every original column. The conversion step stops if a report no longer matches its provenance record. A second tool archives AST and isolate tables exported from NCBI Pathogen Detection, checks each export against an independent count, and builds isolate and endpoint tables offline that can be rebuilt and compared byte for byte. AMRScan does not infer phenotype from determinants; calls and phenotypes are kept as separate layers and joined by assembly accession. The caller wrapper was used to call 10,521 public Escherichia coli assemblies on a workstation without a failed call, and a run of 1,000 of these assemblies through the workflow on an HPC system gave byte-identical reports. The workflow follows nf-core conventions and is tested with unit tests, nf-test and continuous integration. This version replaces the 2025 description of AMRScan 1, a BLAST search against CARD, which is kept unchanged in the repository.},
  html = {https://arxiv.org/abs/2507.08062},
  pdf = {https://arxiv.org/pdf/2507.08062},
  google_scholar_id = {RYcK_YlVTxYC},
  altmetric = {true},
  dimensions = {true},
  preview = {lai2025amrscan.jpg},
  arxiv = {2507.08062},
}

@misc{lai2025cartepigenoqc,
  doi = {10.48550/ARXIV.2507.23048},
  url = {https://arxiv.org/abs/2507.23048},
  author = {Lai, Kaitao},
  keywords = {Genomics (q-bio.GN), FOS: Biological sciences, FOS: Biological sciences},
  title = {CARTEpigenoQC: A Quality Control Toolkit for CAR-T Single-Cell Epigenomic Data},
  publisher = {arXiv},
  year = {2025},
  copyright = {Creative Commons Attribution Non Commercial Share Alike 4.0 International},
  bibtex_show = {true},
  abstract = {CARTEpigenoQC is an R-based toolkit designed to streamline quality control (QC) for single-cell epigenomic datasets involving Chimeric Antigen Receptor (CAR)-engineered T cells. With the growing application of scATAC-seq, scCUT&amp;Tag, and scBS-seq to characterize CAR-T cell states, it has become critical to perform customized QC that not only addresses standard metrics like FRiP (Fraction of Reads in Peaks) and TSS enrichment, but also directly detects signal from CAR vector insertion sites. CARTEpigenoQC supports both 10x Genomics and non-10x data formats and produces HTML and PNG summary outputs suited for exploratory analysis and regulatory-grade preclinical reporting. It is intended to assist researchers, core facilities, and translational immunologists in ensuring the validity of single-cell epigenomic profiling of engineered T cells.},
  html = {https://arxiv.org/abs/2507.23048},
  pdf = {https://arxiv.org/pdf/2507.23048},
  altmetric = {true},
  dimensions = {true},
  preview = {lai2025cartepigenoqc.jpg},
  arxiv = {2507.23048},
}

